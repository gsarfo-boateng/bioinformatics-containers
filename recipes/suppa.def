Bootstrap: docker
From: ubuntu:22.04

%labels
    Author gb3023
    Tool SUPPA

%post
    apt-get update
    apt-get install -y \
        python3 \
        python3-pip \
        git \
        wget \
        ca-certificates

    pip3 install --no-cache-dir numpy pandas scipy

    cd /opt
    git clone https://github.com/comprna/SUPPA.git

    chmod +x /opt/SUPPA/suppa.py

%environment
    export PATH=/opt/SUPPA:$PATH

%runscript
    exec "$@"
