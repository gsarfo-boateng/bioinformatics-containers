Bootstrap: docker
From: continuumio/miniconda3:4.9.2

%labels
    Author gb3023
    Tool SCAPE
    Repository https://github.com/LuChenLab/SCAPE

%post
    set -e

    apt-get update
    apt-get install -y git wget curl build-essential ca-certificates
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    conda config --add channels defaults
    conda config --add channels conda-forge
    conda config --add channels bioconda
    conda config --set channel_priority flexible

    conda create -y -n scape python=3.7.3
    . /opt/conda/etc/profile.d/conda.sh
    conda activate scape

    conda install -y -c conda-forge -c bioconda bedtools=2.26.0
    conda install -y -c conda-forge -c bioconda click=6.7 loguru=0.3.2 numpy=1.17.2 pandas=0.23.4 pybedtools=0.8.1 pysam=0.15.4 scipy=1.3.1 tqdm=4.26.0 r-base=3.6.3 rpy2=3.3.3
    pip install sinfo==0.3.1

    cd /opt
    git clone https://github.com/LuChenLab/SCAPE.git

    chmod -R a+rX /opt/SCAPE

    cat > /usr/local/bin/scape <<'EOF'
#!/bin/bash
. /opt/conda/etc/profile.d/conda.sh
conda activate scape
python /opt/SCAPE/main.py "$@"
EOF

    chmod +x /usr/local/bin/scape

    conda clean -afy

%environment
    export PATH=/usr/local/bin:/opt/conda/envs/scape/bin:/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=scape
    export SCAPE_HOME=/opt/SCAPE

%runscript
    . /opt/conda/etc/profile.d/conda.sh
    conda activate scape
    python /opt/SCAPE/main.py "$@"

%test
    . /opt/conda/etc/profile.d/conda.sh
    conda activate scape
    python --version
    bedtools --version
    python /opt/SCAPE/main.py --help
